<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>com.dolcevida.control.LoginController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProductoController</servlet-name>
        <servlet-class>com.dolcevida.control.ProductoController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MovimientoController</servlet-name>
        <servlet-class>com.dolcevida.control.MovimientoController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FacturaController</servlet-name>
        <servlet-class>com.dolcevida.control.FacturaController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegistroController</servlet-name>
        <servlet-class>com.dolcevida.control.RegistroController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/LoginController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProductoController</servlet-name>
        <url-pattern>/ProductoController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MovimientoController</servlet-name>
        <url-pattern>/MovimientoController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FacturaController</servlet-name>
        <url-pattern>/FacturaController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegistroController</servlet-name>
        <url-pattern>/RegistroController</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
